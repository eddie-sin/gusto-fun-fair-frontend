# Local development only: copy this file to .env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Optional: shows a "Skip code (test)" button on the Quiz page that mints a
# throwaway approved order + privilege code server-side, so the Quiz can be
# played without a real preorder. Must match QUIZ_TEST_KEY on the backend.
# Leave unset in hosted environments.
NEXT_PUBLIC_QUIZ_TEST_KEY=

# npm run build defaults to /api for same-origin hosting behind Nginx.
# To use a separate production API, set NEXT_PUBLIC_API_BASE_URL in the build
# process environment. This public value is compiled into the browser bundle.
# Never put MongoDB, R2, JWT, or other secrets in this frontend project.
